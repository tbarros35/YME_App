# ==============================================================================
# YME APP INTERNA - MODELO DE CONFIGURAÇÃO DE PRODUÇÃO (.env.production)
# ==============================================================================
# Copia este ficheiro para .env.production no servidor e preenche os valores:
#   cp .env.production.example .env.production
#
# DICA: Para gerar chaves secretas fortes, podes correr no terminal:
#   openssl rand -hex 32
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DADOS POSTGRESQL (Contentor yme_postgres)
# ------------------------------------------------------------------------------
POSTGRES_USER=yme_admin
POSTGRES_PASSWORD=altera_para_uma_password_super_segura_aqui_2026
POSTGRES_DB=yme_portal_prod_db

# URL de ligação interna do Prisma (o hostname 'postgres' refere-se ao serviço no docker-compose)
DATABASE_URL=postgresql://yme_admin:altera_para_uma_password_super_segura_aqui_2026@postgres:5432/yme_portal_prod_db?schema=public

# ------------------------------------------------------------------------------
# 2. BACKEND API (Node.js / Express)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3001

# Segredos JWT para geração e validação de tokens de sessão (OBRIGATÓRIO serem longos e únicos)
JWT_SECRET=substitui_por_chave_jwt_aleatoria_minimo_32_chars_123456789
JWT_REFRESH_SECRET=substitui_por_chave_refresh_aleatoria_minimo_32_chars_987654321

# Domínios autorizados para aceder à API (separados por vírgula, sem barras no fim)
# Exemplo com domínio da app:
CORS_ORIGIN=https://app.yme.pt,https://www.app.yme.pt,http://localhost

# ------------------------------------------------------------------------------
# 3. FRONTEND (React / Vite)
# ------------------------------------------------------------------------------
# Em produção com Nginx como Reverse Proxy, os pedidos à API vão para /api
VITE_API_URL=/api

# ------------------------------------------------------------------------------
# 4. CONTA INICIAL DE ADMINISTRADOR (Executive Board)
# ------------------------------------------------------------------------------
# Credenciais usadas pelo script de seed no primeiro arranque
SEED_ADMIN_NAME="Direção YME"
SEED_ADMIN_EMAIL=admin@yme.pt
SEED_ADMIN_PASSWORD=DefinirPasswordForteInicial2026!

# ------------------------------------------------------------------------------
# 5. NOTIFICAÇÕES POR EMAIL (Google Workspace / Gmail SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=geral@yme.pt
SMTP_PASS=aqui_palavra_passe_aplicacao_google_16_caracteres
SMTP_FROM="YME - Young Minho Enterprise" <geral@yme.pt>
APP_URL=https://app.yme.pt
